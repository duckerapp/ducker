<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: облачная копия и перенос на новое устройство настраиваются отдельно.

    В обоих случаях профили и база не копируются: там ссылка подписки (секрет) и
    скачанный конфиг с ключами узлов. Даже при переносе с телефона на телефон подписку
    лучше добавить заново — панель всё равно увидит новое устройство, потому что
    идентификатор привязан к установке.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
    </cloud-backup>

    <device-transfer>
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
