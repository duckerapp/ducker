<?xml version="1.0" encoding="utf-8"?>
<!-- Виджет «Узлы» (D-147): подписка и состояние, кнопка, узлы первой группы. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_ducker"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="@string/launch_name"
                android:textColor="@color/widget_ducker_fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="@string/hero_off"
                android:textColor="@color/widget_ducker_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/widget_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/widget_toggle"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_button_ducker_off" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">

        <!-- Не ListView: коллекция в виджете — самое хрупкое место. Лаунчер ColorOS после
             обновления пакета её не восстанавливал, а Android 10 не отправлял нажатия (F-174).
             Узлов всего пять, строки добавляет код. -->
        <LinearLayout
            android:id="@+id/widget_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/widget_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/widget_nodes_off"
            android:textColor="@color/widget_ducker_muted"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
