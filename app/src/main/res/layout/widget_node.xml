<?xml version="1.0" encoding="utf-8"?>
<!-- Строка узла в виджете «Узлы»; выбранный получает серую плашку (D-147). Своё нажатие у
     каждой строки: это не коллекция, а вложенный RemoteViews (addView). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/node_row"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp">

    <TextView
        android:id="@+id/node_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/widget_ducker_fg"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/node_delay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:singleLine="true"
        android:textColor="@color/widget_ducker_muted"
        android:textSize="13sp" />
</LinearLayout>
