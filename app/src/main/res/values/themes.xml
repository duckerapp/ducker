<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Тема нужна системе до того, как заработает Compose: фон окна, системные панели,
        отсутствие ActionBar. Всё остальное рисует сам Compose (ui/theme/Theme.kt).

        Родитель — AppCompat, потому что главный экран наследует AppCompatActivity:
        до Android 13 выбор языка приложения работает только через него (D-49).
    -->
    <style name="BootstrapTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!-- Заставка Android 12+: своя утка под тему системы — белая с иконки запуска
             на светлом фоне окна не видна (D-95). Собрана build-icons.py. -->
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_icon</item>
    </style>
</resources>
